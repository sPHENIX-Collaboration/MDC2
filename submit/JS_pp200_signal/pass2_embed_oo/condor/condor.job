Universe 	= vanilla
Executable 	= $(executable)
Arguments       = $(nevents) $(infile0) $(infile1) $(infile2) $(infile3) $(dstoutdir) $(jettrigger) $(build) $(runnumber) $(sequence) $(fm) $(pileup)
Output  	= $(outfile)
Error 		= $(errfile)
Log  		= $(condorlogfile)
Initialdir  	=  $(rundir)
PeriodicHold 	= (NumJobStarts>=1 && JobStatus == 1)
request_memory = $(memory)
batch_name = $(batchname)
Priority = $(baseprio)
job_lease_duration = 3600
Queue executable, nevents, infile0, infile1, infile2, infile3, dstoutdir, jettrigger, build, runnumber, sequence, fm, pileup, outfile, errfile, condorlogfile, rundir, baseprio, memory, batchname from condor.list
